{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/chatbot", "dest": "/chatbot.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/signup", "dest": "/signup.html" },
    { "src": "/demo", "dest": "/demo.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/blog", "dest": "/blog.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/help", "dest": "/help.html" },
    { "src": "/docs", "dest": "/docs.html" },
    { "src": "/status", "dest": "/status.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/cookies", "dest": "/cookies.html" },
    { "src": "/gdpr", "dest": "/gdpr.html" },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/", "dest": "/index.html" }
  ]
}
